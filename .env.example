# Base de données PostgreSQL
DATABASE_URL="postgresql://prodevis:prodevis@localhost:5432/prodevis?schema=public"

# Clé secrète pour signer les jetons JWT (changez-la en production)
AUTH_SECRET="change-me-in-production-please-use-a-long-random-string"

# ─── Intelligence artificielle (optionnel) ───
# Fournisseur : OpenRouter (https://openrouter.ai/keys) — une seule clé donne
# accès à de nombreux modèles (Gemini, Claude, GPT, modèles gratuits…).
# Sans cette clé, les fonctionnalités IA sont simplement masquées.
OPENROUTER_API_KEY=""
# Modèle de rédaction/structuration (défaut : google/gemini-2.0-flash-001)
# OPENROUTER_MODEL="google/gemini-2.0-flash-001"
# Modèle avec recherche web pour estimer les prix (défaut : <model>:online)
# OPENROUTER_SEARCH_MODEL="google/gemini-2.0-flash-001:online"

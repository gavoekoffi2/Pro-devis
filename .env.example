# ─── Base de données PostgreSQL (obligatoire) ───
DATABASE_URL="postgresql://prodevis:prodevis@localhost:5432/prodevis?schema=public"

# ─── Clé secrète de signature des sessions (OBLIGATOIRE en production) ───
# 16 caractères minimum. Générez-la avec : openssl rand -base64 32
# ⚠️ L'application REFUSE de démarrer en production avec la valeur d'exemple
#    ci-dessous : un secret public permettrait de forger n'importe quelle session.
AUTH_SECRET=""

# ─── Intelligence artificielle (optionnel) ───
# Fournisseur : OpenRouter (https://openrouter.ai/keys) — une seule clé donne
# accès à de nombreux modèles (Gemini, Claude, GPT, modèles gratuits…).
# Sans cette clé, les fonctionnalités IA sont simplement masquées.
OPENROUTER_API_KEY=""
# Modèle de rédaction / structuration (défaut : google/gemini-2.5-flash-lite)
# OPENROUTER_MODEL="google/gemini-2.5-flash-lite"
# Modèle avec recherche web pour estimer les prix (défaut : <modèle>:online)
# OPENROUTER_SEARCH_MODEL="google/gemini-2.5-flash-lite:online"

# URL publique du site, envoyée à OpenRouter dans l'en-tête HTTP-Referer.
# NEXT_PUBLIC_APP_URL="https://pro-devis.app"
